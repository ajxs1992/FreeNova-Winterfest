#define PLUGIN_VERSION  "2.0.0"
#define PLUGIN_AUTHOR   "FreeNova Dev Team"

// ============================================================
// FreeNova Unified VIP - the single authoritative VIP system.
//
// v2.0.0: vip_ajxs_classic was merged into this core. Every
// former classic feature lives here now, gated by tier, so a
// higher tier unlocks strictly more features. vip_ajxs_classic
// is retired; do not load it alongside this plugin. The fnvip_*
// native API is unchanged, so BattlePass, panel, CRX and the
// weapon-models plugin need no edits.
//
// Ownership rules:
//  - This plugin owns tier truth. Every other plugin asks via the
//    fnvip_* natives instead of reading flags or keeping its own
//    VIP state.
//  - Flags r/q/p are DERIVED here for legacy consumers (CRX VIP XP
//    table reads flag r live; old configs check r/q/p/t). Bits this
//    plugin sets are tracked and only those bits are ever removed.
//  - Entitlements are additive and never overwrite a better one:
//    resolved tier = highest valid tier across static flags and all
//    timed entitlements (spec: never downgrade an existing VIP).
//  - All persistence is per-authid in nVault 'freenova_vip'
//    (dedicated handle - CRX's vault must never be touched twice).
// ============================================================

#define MAX_ENT_SOURCES 6

// Registration reward: 72 hours of the middle tier (VIP+)
#define REG_TRIAL_SECONDS 259200

// Reminder thresholds (seconds remaining) - one notice each
#define REMIND_24H 86400
#define REMIND_6H  21600
#define REMIND_1H  3600

// Per-player task ids MUST use unique bases. AMXX task ids are global across
// every plugin; raw player index collides with panel TASK_PANEL/TASK_EVENT
// offsets, adminhelp, CRX, and anything else that set_task(..., id).
#define TASK_LATE   54000
#define TASK_VIPIN  54100
#define TASK_MENU   54200
#define TASK_VIPTAB 54300

// Legacy runtime flag used by the free-VIP event
#define VIP_FLAG "r"

// --- Merged classic feature gates (tier required per feature) ---
// VIP(1):   chat tag, join/leave notices, TAB badge, kill HP/AP/money,
//           CT defuse kit
// VIP+(2):  + spawn HP/AP & money, armory menu (/vmenu), VIP player
//           model, bullet-damage HUD, parachute
// ELITE(3): + multi-jump, free-VIP event window (perk preview)
#define TIER_CHAT       FNVIP_VIP
#define TIER_INOUT      FNVIP_VIP
#define TIER_TAB        FNVIP_VIP
#define TIER_KILLBONUS  FNVIP_VIP
#define TIER_DEFUSEKIT  FNVIP_VIP
#define TIER_SPAWN      FNVIP_VIPPLUS
#define TIER_ARMORY     FNVIP_VIPPLUS
#define TIER_MODEL      FNVIP_VIPPLUS
#define TIER_BULLETDMG  FNVIP_VIPPLUS
#define TIER_PARACHUTE  FNVIP_VIPPLUS
#define TIER_MULTIJUMP  FNVIP_ELITE
#define TIER_FREEVIP    FNVIP_ELITE

new const g_szVaultName[] = "freenova_vip";

new g_Vault = INVALID_HANDLE;
new g_fwdTierChanged;

// Resolved runtime state
new g_Tier[MAX_PLAYERS + 1];        // resolved tier (FNVIP_*)
new g_StaticTier[MAX_PLAYERS + 1];  // tier from users.ini-style flags
new g_EntTier[MAX_PLAYERS + 1];     // highest valid entitlement tier
new g_EntExpire[MAX_PLAYERS + 1];   // its expiry (unix), 0 = none
new g_EntSource[MAX_PLAYERS + 1];   // its source (FNVIP_SRC_*)
new g_SyncedBits[MAX_PLAYERS + 1];  // flag bits WE set (never touch others')
new g_RemindMask[MAX_PLAYERS + 1];  // one-shot trial reminder buckets
new g_szAuth[MAX_PLAYERS + 1][40];  // normalized authid ("_" for ':')
new bool:g_bValid[MAX_PLAYERS + 1]; // human with a usable authid

// --- merged classic state ---
new g_JumpNum[MAX_PLAYERS + 1];
new bool:g_DoJump[MAX_PLAYERS + 1];
new bool:g_Use[MAX_PLAYERS + 1];             // armory used this round
new bool:g_MenuOK[MAX_PLAYERS + 1];          // armory available on this map
new g_iPrimaryChoice[MAX_PLAYERS + 1];
new g_iSavedPistol[MAX_PLAYERS + 1];
new g_iPosition[MAX_PLAYERS + 1];            // damage HUD ring position
new bool:g_bFreeVipGranted[MAX_PLAYERS + 1]; // event flag WE granted
new bool:g_bStaticRAtGrant[MAX_PLAYERS + 1]; // users.ini r already present at grant
new bool:g_bWasFreeVip;
new CurrentRound;
