new g_pParachute;     // vip_parachute
new g_pMoneyKill;     // vip_money_kill
new g_pMoneyHS;       // vip_money_hs
new g_pBulletDmgMode; // vip_bulletdmg_mode
new g_pTab;           // vip_tab
