new g_pDebug;

// --- merged classic cvars (same names as vip_ajxs_classic, so an
// existing vipConfig.cfg keeps working) ---
new g_pMode;          // vip_mode
new g_pTag;           // vip_tag
new g_pTierTags;      // vip_tier_tags
new g_pStartHP;       // vip_start_hp
new g_pStartAP;       // vip_start_ap
new g_pStartMoney;    // vip_start_money
new g_pJump;          // vip_jump
new g_pHPKill;        // vip_hp_kill
new g_pAPKill;        // vip_ap_kill
new g_pHPHS;          // vip_hp_hs
new g_pAPHs;          // vip_ap_hs
new g_pHPKillKnife;   // vip_hp_kill_knife
new g_pAPKillKnife;   // vip_ap_kill_knife
new g_pHPHSKnife;     // vip_hp_hs_knife
new g_pAPHsKnife;     // vip_ap_hs_knife
new g_pBulletDmg;     // vip_bulletdmg
new g_pModel;         // vip_model
