public Cmd_Ban(id)
{
    if(!is_user_connected(id)) return PLUGIN_HANDLED
    if(!(get_user_flags(id) & FLAG_ADMIN))
    {
        client_printcolor(id, "!g[FreeNova] !nAdmin only.")
        return PLUGIN_HANDLED
    }
    ShowPlayerSelect(id, "ban")
    return PLUGIN_HANDLED
}

