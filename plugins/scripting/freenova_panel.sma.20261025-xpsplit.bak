    g_iBanTarget[id] = tid
    g_iBanUserid[id] = get_user_userid(tid)
    get_user_authid(tid, g_szBanAuth[id], charsmax(g_szBanAuth[]))
    ShowCoinActionSelect(id)

    return PLUGIN_HANDLED
}

ShowCoinActionSelect(id)
{
    if( !PanelBanTargetValid(id) )
