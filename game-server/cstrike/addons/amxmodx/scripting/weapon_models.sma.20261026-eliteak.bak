#define VERSION "5.0"
#define AUTHOR  "FreeNova Dev"

#define CONFIG_FILE             "skins_menu.cfg"
#define CUSTOM_SKINS_FILE       "custom_skins.ini"
#define MASTERY_SKINS_FILE      "mastery_skins.ini"
#define VAULT_NAME              "freenova_weapon_skins"

#define MAX_PLAYERS             32
#define MAX_SKINS_PER_GROUP     64
#define SKIN_NAME_LEN           32
#define MODEL_PATH_LEN          128
#define CONFIG_LINE_LEN         256
#define PLAYER_ID_LEN           64
#define VAULT_KEY_LEN           96
#define VAULT_DATA_LEN          256
// Task IDs must not collide with other plugins' per-player task ranges.
// battlepass_core uses TASK_SPAWN=7000 and TASK_HUD=8000 (id+base).
// This plugin uses 7600/7650 to avoid those ranges.
#define TASK_LOAD_PLAYER        7600
new g_iLoadPlayerRetries[33];
#define TASK_SPAWN_MODEL        7650

// Skin gates marked as BP levels must use the BattlePass tier ledger, not the
// RSU rank level. Fail closed while battlepass_core is still loading.
stock GetBpLevel(id)
{
    // Fail closed: BP-gated skins must never fall back to the separate RSU
    // rank level. If battlepass_core is absent/not ready, the gate is locked.
    if (!LibraryExists("menabp", LibType_Library))
        return 0;
    if (!menabp_is_ready(id))
        return 0;
    return menabp_get_tier(id);
}

