// ============================================================
// PLUGIN LIFECYCLE & NATIVES
// ============================================================

public plugin_precache()
{
    BuildConfigPath();
    LoadSkinsConfig();
    LoadMasterySkinsConfig();
    PrecacheLoadedModels();

    BuildCustomSkinsPath();
    LoadAndPrecacheCustomSkins();
    LoadAndPrecacheForcedModels();
}

public plugin_init()
{
    register_plugin(PLUGIN, VERSION, AUTHOR);

    g_pCustomOrderCost = register_cvar("fn_custom_skin_cost", "50000");

    g_Vault = nvault_open(VAULT_NAME);
    if (g_Vault == INVALID_HANDLE)
    {
        set_fail_state("Failed to open nVault.");
    }

    RegisterHam(Ham_Spawn, "player", "Hook_PlayerSpawn", 1);

    register_clcmd("say /skins", "CmdOpenSkins");
    register_clcmd("say_team /skins", "CmdOpenSkins");
    register_clcmd("say /models", "CmdOpenModels");
    register_clcmd("say_team /models", "CmdOpenModels");
    register_clcmd("say /customskin", "Cmd_CustomSkinCmd");
    register_clcmd("say_team /customskin", "Cmd_CustomSkinCmd");
    register_clcmd("say /customskins", "Cmd_CustomSkinCmd");
    register_clcmd("say_team /customskins", "Cmd_CustomSkinCmd");

    register_concmd("fn_set_skin", "Cmd_AdminSetSkin", ADMIN_RCON, "<target> <weapon|player> <group|team> <v_model|model> [p_model]");
    register_concmd("fn_remove_skin", "Cmd_AdminRemoveSkin", ADMIN_RCON, "<target> [weapon|player|all]");
    register_concmd("fn_list_skins", "Cmd_AdminListSkins", ADMIN_RCON, "- List all assigned custom skins");
    register_concmd("fn_skin_orders", "Cmd_AdminSkinOrders", ADMIN_BAN, "- List custom skin orders");

    register_event("CurWeapon", "EventCurWeapon", "be", "1=1");
}

