    return (BpValidId(id) && g_bBpXpLoaded[id]) ? BpGetTier(id) : 0
}
public native_get_bp_next_xp(plugin, params)
{
    new id = get_param(1)
    if (!BpValidId(id) || !g_bBpXpLoaded[id])
        return 0
    new iTier = BpGetTier(id)
    return (iTier < MAX_LEVELS) ? BpTierThreshold(iTier + 1) : BpTierThreshold(MAX_LEVELS)
}
