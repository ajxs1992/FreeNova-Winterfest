public native_show_motd(plugin, params)
{
    new id = get_param(1)
    if(!(1 <= id <= MAX_PLAYERS) || !is_user_connected(id))
        return 0

    new szTab[32]
    get_string(2, szTab, charsmax(szTab))
    return ShowWebPassMotd(id, szTab) ? 1 : 0
}

stock bool:BpValidId(id)
{
    return (1 <= id <= MAX_PLAYERS)
}

